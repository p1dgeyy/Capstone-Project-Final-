{
  "name": "capstone-portal",
  "version": "2.0.0",
  "description": "PESO/CSWDO Beneficiary Management Portal — Powered by Supabase",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "npx serve frontend -l 3000",
    "docker:build": "docker build -t capstone-portal .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "prisma": "^8.0.0-rc.12"
  }
}
