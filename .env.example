# Database Configuration
MYSQL_URL=mysql://root:root@localhost:3306/capstone_db
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=root
MYSQLDATABASE=capstone_db

# Server & Security Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=your_jwt_session_secret_key_here
JWT_SECRET=your_jwt_secret_key_here
REFRESH_SECRET=your_refresh_token_secret_key_here

# SMTP Email Gateway Configuration (Gmail App Password or SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=peso.koronadal.portal@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="City of Koronadal PESO/CSWDO Portal <peso.koronadal.portal@gmail.com>"

# SMS Gateway Configuration (e.g., Semaphore, Twilio, PhilSMS)
SMS_GATEWAY_URL=https://api.semaphore.co/api/v4/messages
SMS_API_KEY=your_sms_api_key_here
SMS_API_SECRET=your_sms_gateway_secret_here
SMS_SENDER_NAME=KORONADAL
