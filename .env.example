# =============================================================================
# Capstone Portal — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database (Railway MySQL) ---
# Option A: Unified connection string (preferred for Railway)
MYSQL_URL=mysql://user:password@host:port/database
# DATABASE_URL=mysql://user:password@host:port/database

# Option B: Individual connection variables
# MYSQLHOST=localhost
# MYSQLUSER=root
# MYSQLPASSWORD=yourpassword
# MYSQLDATABASE=capstone_portal
# MYSQLPORT=3306

# --- Resend Email API ---
# Sign up at https://resend.com to get your API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Clerk (optional — for future integration) ---
# Sign up at https://clerk.com to get your API keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# --- Server ---
API_PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
