<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PESO Officer Portal - City of Koronadal</title>
    <!-- Dependencies -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- API Configuration -->
    <meta name="api-base-url" content="https://capstone-project-final-production.up.railway.app">
    <script src="assets/js/api-config.js"></script>

    <style>
        :root {
            --primary: #0284C7;
            --primary-hover: #0369A1;
            --primary-light: #E0F2FE;
            --dark-navy: #0F172A;
            --sidebar-width: 270px;
            --header-height: 70px;
            --bg-light: #F8FAFC;
            --card-border: #E2E8F0;
            --success: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
            --info: #3B82F6;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Outfit', sans-serif;
        }

        body {
            background-color: var(--bg-light);
            color: #1E293B;
            overflow-x: hidden;
        }

        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #FFFFFF;
            border-right: 1px solid var(--card-border);
            z-index: 100;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 20px 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--card-border);
        }

        .sidebar-brand-text h5 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary);
            margin: 0;
        }

        .sidebar-menu {
            padding: 16px 12px;
            list-style: none;
            flex-grow: 1;
            overflow-y: auto;
        }

        .sidebar-menu .nav-header {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94A3B8;
            margin: 16px 12px 8px;
        }

        .sidebar-menu .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            color: #64748B;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
        }

        .sidebar-menu .nav-link:hover,
        .sidebar-menu .nav-link.active {
            background-color: var(--primary-light);
            color: var(--primary);
        }

        .header-top {
            position: fixed;
            top: 0;
            right: 0;
            left: var(--sidebar-width);
            height: var(--header-height);
            background: #FFFFFF;
            border-bottom: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            z-index: 99;
        }

        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: var(--header-height);
            padding: 28px;
            min-height: calc(100vh - var(--header-height));
        }

        .page-header {
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .stat-card {
            background: #FFFFFF;
            border: 1px solid var(--card-border);
            border-radius: 14px;
            padding: 20px;
        }

        .badge-approved { background-color: #10B981; color: white; }
        .badge-denied { background-color: #EF4444; color: white; }
        .badge-pending { background-color: #F59E0B; color: white; }
    </style>
</head>
<body>

    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div>
                <h5>PESO Officer Portal</h5>
                <small class="text-muted">City of Koronadal</small>
            </div>
        </div>
        <ul class="sidebar-menu">
            <li class="nav-header">Main Menu</li>
            <li class="nav-item"><a href="#" class="nav-link active" onclick="switchTab('dashboard')"><i class="bi bi-grid-1x2"></i> Overview Dashboard</a></li>
            <li class="nav-item"><a href="#" class="nav-link" onclick="switchTab('beneficiaries')"><i class="bi bi-people-fill"></i> Beneficiaries Management</a></li>
            <li class="nav-item"><a href="#" class="nav-link" onclick="switchTab('evaluation')"><i class="bi bi-clipboard-check"></i> Application Evaluation</a></li>
            <li class="nav-item"><a href="#" class="nav-link" onclick="switchTab('livelihood-mgmt')"><i class="bi bi-diagram-3"></i> Livelihood Applications & Batches</a></li>
            <li class="nav-item"><a href="#" class="nav-link" onclick="switchTab('approved-assistance')"><i class="bi bi-box-seam"></i> Approved Assistance & Reports</a></li>
            <li class="nav-header">Tools</li>
            <li class="nav-item"><a href="#" class="nav-link" onclick="openQrScannerModal()"><i class="bi bi-qr-code-scan"></i> QR Scanner Lookup</a></li>
            <li class="nav-item"><a href="#" class="nav-link" onclick="openAuditModal()"><i class="bi bi-journal-text"></i> Audit Logs</a></li>
        </ul>
    </aside>

    <!-- Header Bar -->
    <header class="header-top">
        <h6 class="m-0 fw-bold text-primary">PESO Officer Operations Dashboard</h6>
        <div class="d-flex align-items-center gap-3">
            <span class="fw-semibold">PESO Officer</span>
            <button class="btn btn-sm btn-outline-danger" onclick="logoutOfficer()"><i class="bi bi-box-arrow-right"></i> Logout</button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">

        <!-- 1. OVERVIEW DASHBOARD -->
        <section id="tab-dashboard" class="tab-section">
            <div class="page-header">
                <h1 class="page-title">PESO Officer Overview</h1>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-3"><div class="stat-card"><h5>Pending Evaluations</h5><h2 class="text-warning">3</h2></div></div>
                <div class="col-md-3"><div class="stat-card"><h5>Approved Applications</h5><h2 class="text-success">8</h2></div></div>
                <div class="col-md-3"><div class="stat-card"><h5>Assigned Beneficiaries</h5><h2 class="text-info">142</h2></div></div>
                <div class="col-md-3"><div class="stat-card"><h5>Disbursed Funds</h5><h2 class="text-primary">₱3.85M</h2></div></div>
            </div>
        </section>

        <!-- 2. BENEFICIARIES MANAGEMENT -->
        <section id="tab-beneficiaries" class="tab-section d-none">
            <div class="page-header">
                <h1 class="page-title">Beneficiaries Management</h1>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>QR ID</th><th>Name</th><th>Barangay & Address</th><th>Contact & Email</th><th>Program</th><th>Status</th><th class="text-end">Action</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>BEN-2026-001</td><td class="fw-semibold">Juan Dela Cruz</td><td>Morales</td><td>09171234567</td><td>TUPAD</td><td><span class="badge bg-success">Active</span></td><td class="text-end"><button class="btn btn-sm btn-outline-primary">Info Card</button></td></tr>
                            <tr><td>BEN-2026-002</td><td class="fw-semibold">Maria Santos</td><td>Poblacion</td><td>09189876543</td><td>PFAS</td><td><span class="badge bg-success">Active</span></td><td class="text-end"><button class="btn btn-sm btn-outline-primary">Info Card</button></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 3. APPLICATION EVALUATION -->
        <section id="tab-evaluation" class="tab-section d-none">
            <div class="page-header">
                <h1 class="page-title">Application Evaluation Queue</h1>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>App ID</th><th>Beneficiary Name</th><th>Program Applied</th><th>Submission Date</th><th>Status</th><th class="text-end">Action</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>APP-2026-001</td><td>Juan Dela Cruz</td><td>TUPAD</td><td>2026-02-10</td><td><span class="badge badge-pending">Pending</span></td><td class="text-end"><button class="btn btn-sm btn-primary">Evaluate</button></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-section').forEach(el => el.classList.add('d-none'));
            document.querySelectorAll('.sidebar-menu .nav-link').forEach(el => el.classList.remove('active'));
            document.getElementById(`tab-${tabId}`).classList.remove('d-none');
            event.currentTarget.classList.add('active');
        }

        function logoutOfficer() {
            window.location.href = 'official_login.html';
        }
    </script>
</body>
</html>
