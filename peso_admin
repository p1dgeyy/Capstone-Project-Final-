            { id: 112, code: 'PAROKYA_OWWA', name: 'Support to Parokya ni OWWA Program', category: 'Other Programs', budget: 40000.00, beneficiaries_count: 20, target_beneficiaries: 'OWWA Members', assistance_type: 'Cash & Welfare Guidance', description: 'Emergency desk for migrant workers.', eligibility_criteria: 'OWWA member in distress.', limitations: 'Reintegration assistance.', restrictions: 'OWWA coordination required.', ordinance: 'Appropriation Ordinance No. 6, Series of 2025', status: 'Active' },
            { id: 113, code: 'ROFW', name: 'Support to Returning OFWs Program (ROFW’s)', category: 'Other Programs', budget: 100000.00, beneficiaries_count: 35, target_beneficiaries: 'Returning OFWs', assistance_type: 'Starter Kits & Training', description: 'Reintegration package for returned OFWs.', eligibility_criteria: 'Returned OFW permanently residing in Koronadal.', limitations: 'One-time package.', restrictions: 'Must present passport.', ordinance: 'Appropriation Ordinance No. 6, Series of 2025', status: 'Active' }
        ];

        let programsList = [];
        let uploadedOrdinances = [];

        document.addEventListener('DOMContentLoaded', () => {
            const localData = localStorage.getItem('peso_livelihood_programs_v1');
            if (localData) {
                try { programsList = JSON.parse(localData); } catch (e) { programsList = [...INITIAL_PROGRAMS]; }
            } else {
                programsList = [...INITIAL_PROGRAMS];
                localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList));
            }
            renderDashboardTables();
        });

        function renderDashboardTables() {
            const activeList = programsList.filter(p => p.status === 'Active');
            const archiveList = programsList.filter(p => p.status !== 'Active');
            const totalBudget = programsList.reduce((sum, p) => sum + (Number(p.budget) || 0), 0);

            document.getElementById('statTotalPrograms').textContent = programsList.length;
            document.getElementById('statActivePrograms').textContent = activeList.length;
            document.getElementById('statArchivedPrograms').textContent = archiveList.length;
            document.getElementById('archiveBadgeCount').textContent = archiveList.length;
            document.getElementById('archiveSectionCountBadge').textContent = `${archiveList.length} Deactivated Programs`;
            document.getElementById('statTotalBudget').textContent = '₱' + totalBudget.toLocaleString('en-US', { minimumFractionDigits: 2 });

            filterPrograms();
            renderArchiveTable(archiveList);
            renderOrdinanceBreakdownTable();
        }

        function filterPrograms() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const cat = document.getElementById('categoryFilter').value;
            const tbody = document.getElementById('programsTableBody');
            tbody.innerHTML = '';

            const filtered = programsList.filter(p => {
                const matchesSearch = p.name.toLowerCase().includes(search) || p.code.toLowerCase().includes(search) || p.description.toLowerCase().includes(search);
                const matchesCat = (cat === 'ALL') || (p.category === cat);
                return matchesSearch && matchesCat;
            });

            filtered.forEach(prog => {
                const tr = document.createElement('tr');
                const isDeactivated = prog.status !== 'Active';
                tr.innerHTML = `
                    <td><div class="fw-bold text-dark">${escapeHtml(prog.name)}</div><span class="badge bg-dark-subtle text-dark font-monospace">${escapeHtml(prog.code)}</span></td>
                    <td><span class="badge badge-category badge-emp">${escapeHtml(prog.category)}</span><div class="small text-muted mt-1">${escapeHtml(prog.assistance_type || '')}</div></td>
                    <td><div class="fw-bold text-success">₱${Number(prog.budget).toLocaleString('en-US', {minimumFractionDigits: 2})}</div></td>
                    <td><span class="badge bg-light text-dark border"><i class="bi bi-people-fill text-primary me-1"></i>${prog.beneficiaries_count || 0} enrolled</span></td>
                    <td><div class="text-truncate" style="max-width: 200px;">${escapeHtml(prog.limitations || 'None')}</div></td>
                    <td><small class="fw-semibold text-secondary">${escapeHtml(prog.ordinance || 'Ordinance No. 6')}</small></td>
                    <td class="text-center">
                        <div class="form-check form-switch d-inline-block">
                            <input class="form-check-input" type="checkbox" role="switch" ${!isDeactivated ? 'checked' : ''} onchange="handleProgramToggle(event, ${prog.id})">
                        </div>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary me-1" onclick="openProgramDetailsModal(${prog.id})">Details</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderArchiveTable(archiveList) {
            const tbody = document.getElementById('archiveTableBody');
            tbody.innerHTML = '';
            if (archiveList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted">Archive is clean. No deactivated programs currently.</td></tr>`;
                return;
            }
            archiveList.forEach(prog => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><div class="fw-bold text-dark">${escapeHtml(prog.name)}</div><span class="badge bg-secondary font-monospace">${escapeHtml(prog.code)}</span></td>
                    <td>${escapeHtml(prog.category)}</td>
                    <td>₱${Number(prog.budget).toLocaleString()}</td>
                    <td>${escapeHtml(prog.target_beneficiaries || '')}</td>
                    <td>${new Date().toLocaleDateString()}</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-success me-1" onclick="restoreProgram(${prog.id})">Restore</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="permanentlyDeleteProgram(${prog.id})">Delete</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function handleProgramToggle(event, progId) {
            const prog = programsList.find(p => p.id === progId);
            if (!prog) return;
            if (!event.target.checked) {
                if ((prog.beneficiaries_count || 0) > 0) {
                    event.target.checked = true;
                    document.getElementById('restrictionWarningText').innerHTML = `Cannot deactivate program <strong>"${escapeHtml(prog.name)}"</strong>. It currently has active enrolled beneficiaries.`;
                    new bootstrap.Modal(document.getElementById('restrictionWarningModal')).show();
                    return;
                }
                if (confirm(`Deactivate "${prog.name}"?`)) {
                    prog.status = 'Deactivated';
                    localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList));
                    renderDashboardTables();
                } else { event.target.checked = true; }
            } else {
                prog.status = 'Active';
                localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList));
                renderDashboardTables();
            }
        }

        function restoreProgram(progId) {
            const prog = programsList.find(p => p.id === progId);
            if (prog) { prog.status = 'Active'; localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList)); renderDashboardTables(); }
        }

        function permanentlyDeleteProgram(progId) {
            if (confirm('Permanently delete program?')) {
                programsList = programsList.filter(p => p.id !== progId);
                localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList));
                renderDashboardTables();
            }
        }

        function openProgramDetailsModal(progId) {
            const prog = programsList.find(p => p.id === progId);
            if (!prog) return;
            document.getElementById('detailProgId').value = prog.id;
            document.getElementById('detailModalTitle').textContent = prog.name;
            document.getElementById('detailModalCodeBadge').textContent = prog.code;
            document.getElementById('detailProgName').value = prog.name;
            document.getElementById('detailProgCode').value = prog.code;
            document.getElementById('detailProgCategory').value = prog.category;
            document.getElementById('detailProgBudget').value = prog.budget;
            document.getElementById('detailProgBeneficiaries').value = prog.beneficiaries_count || 0;
            document.getElementById('detailProgDesc').value = prog.description || '';
            document.getElementById('detailProgTarget').value = prog.target_beneficiaries || '';
            document.getElementById('detailProgAssistance').value = prog.assistance_type || '';
            document.getElementById('detailProgEligibility').value = prog.eligibility_criteria || '';
            document.getElementById('detailProgLimitations').value = prog.limitations || '';
            document.getElementById('detailProgOrdinance').value = prog.ordinance || '';
            new bootstrap.Modal(document.getElementById('programDetailsModal')).show();
        }

        function saveProgramUpdates() {
            const progId = Number(document.getElementById('detailProgId').value);
            const prog = programsList.find(p => p.id === progId);
            if (prog) {
                prog.name = document.getElementById('detailProgName').value.trim();
                prog.code = document.getElementById('detailProgCode').value.trim();
                prog.category = document.getElementById('detailProgCategory').value;
                prog.budget = Number(document.getElementById('detailProgBudget').value) || 0;
                prog.description = document.getElementById('detailProgDesc').value.trim();
                prog.target_beneficiaries = document.getElementById('detailProgTarget').value.trim();
                prog.assistance_type = document.getElementById('detailProgAssistance').value.trim();
                prog.eligibility_criteria = document.getElementById('detailProgEligibility').value.trim();
                prog.limitations = document.getElementById('detailProgLimitations').value.trim();
                prog.ordinance = document.getElementById('detailProgOrdinance').value.trim();
                localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList));
                bootstrap.Modal.getInstance(document.getElementById('programDetailsModal')).hide();
                renderDashboardTables();
            }
        }

        function openCreateProgramModal() {
            document.getElementById('createProgramForm').reset();
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('newProgDateTime').value = now.toISOString().slice(0, 16);
            new bootstrap.Modal(document.getElementById('createProgramModal')).show();
        }

        function handleCreateProgramSubmit(e) {
            e.preventDefault();
            const newProg = {
                id: Date.now(),
                name: document.getElementById('newProgName').value.trim(),
                code: document.getElementById('newProgCode').value.trim().toUpperCase(),
                category: document.getElementById('newProgCategory').value,
                budget: Number(document.getElementById('newProgBudget').value) || 0,
                description: document.getElementById('newProgDesc').value.trim(),
                target_beneficiaries: document.getElementById('newProgTarget').value.trim(),
                assistance_type: document.getElementById('newProgAssistance').value,
                eligibility_criteria: document.getElementById('newProgEligibility').value.trim(),
                limitations: document.getElementById('newProgLimitations').value.trim(),
                ordinance: document.getElementById('newProgOrdinance').value.trim(),
                beneficiaries_count: 0,
                status: 'Active'
            };
            programsList.unshift(newProg);
            localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList));
            bootstrap.Modal.getInstance(document.getElementById('createProgramModal')).hide();
            renderDashboardTables();
        }

        function openUploadOrdinanceModal() {
            new bootstrap.Modal(document.getElementById('uploadOrdinanceModal')).show();
        }

        function handleUploadOrdinance(e) {
            e.preventDefault();
            bootstrap.Modal.getInstance(document.getElementById('uploadOrdinanceModal')).hide();
            alert('Ordinance uploaded successfully.');
        }

        function showOrdinanceReferenceModal() {
            const tbody = document.getElementById('ordinanceBreakdownTableBody');
            tbody.innerHTML = '';
            programsList.forEach(prog => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${escapeHtml(prog.category)}</td>
                    <td class="fw-semibold">${escapeHtml(prog.name)}</td>
                    <td class="font-monospace">${escapeHtml(prog.code)}</td>
                    <td class="text-end fw-bold text-success">₱${Number(prog.budget).toLocaleString()}</td>
                `;
                tbody.appendChild(tr);
            });
            new bootstrap.Modal(document.getElementById('ordinanceReferenceModal')).show();
        }

        function showAuditLogsModal() {
            const tbody = document.getElementById('auditLogsModalTableBody');
            tbody.innerHTML = `<tr><td colspan="5" class="text-center py-3 text-muted">System operational log clean.</td></tr>`;
            new bootstrap.Modal(document.getElementById('auditLogsModal')).show();
        }

        function scrollToArchive() { document.getElementById('archiveSection').scrollIntoView({ behavior: 'smooth' }); }
