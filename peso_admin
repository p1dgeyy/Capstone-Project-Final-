    <div class="modal fade" id="ordinanceReferenceModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header bg-dark text-white"><h5 class="modal-title">Ordinance Ref</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><table class="table table-bordered table-sm"><tbody id="ordinanceBreakdownTableBody"></tbody></table></div></div></div></div>
    <div class="modal fade" id="auditLogsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header bg-info text-white"><h5 class="modal-title">Audit Trail</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><table class="table table-sm"><tbody id="auditLogsModalTableBody"></tbody></table></div></div></div></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const INITIAL_PROGRAMS = [
            { id: 101, code: 'CKGIP', name: 'City of Koronadal Government Internship Program (CKGIP)', category: 'Employment Facilitation', budget: 500000.00, beneficiaries_count: 25, total_slots: 30, status: 'Active' },
            { id: 102, code: 'KEEP', name: 'Koronadal Emergency Employment Program (KEEP)', category: 'Employment Facilitation', budget: 1500000.00, beneficiaries_count: 60, total_slots: 80, status: 'Active' },
            { id: 104, code: 'PFAS', name: 'Pangkabuhayan Financial Assistance (PFAS)', category: 'Livelihood Programs', budget: 7000000.00, beneficiaries_count: 140, total_slots: 150, status: 'Active' },
            { id: 111, code: 'SPES', name: 'Special Program for Employment of Students (SPES)', category: 'Other Programs', budget: 2000000.00, beneficiaries_count: 180, total_slots: 200, status: 'Active' }
        ];

        const PROGRAM_BATCHES = {
            101: [{ batch_id: 1011, batch_num: 'Batch 2026-A (LGU Intake)', date: '2026-03-15', trainer: 'Hon. Mark Gonzales', enrolled: 15, total: 15 }],
            104: [{ batch_id: 1041, batch_num: 'Batch 1 (Micro-Retail)', date: '2026-03-01', trainer: 'Dr. Elena Torralba', enrolled: 70, total: 75 }]
        };

        const BATCH_BENEFICIARIES = {
            1011: [{ id: 6, full_name: 'Juan Santos Dela Cruz', phone: '0905-111-2222', address: 'Barangay Zone IV, Koronadal', age: 29, sex: 'Male', civil_status: 'Single', birthday: '1997-04-12', children: 0, spouse: 'N/A', valid_id: 'PhilID', business_type: 'Micro-Enterprise', program_component: 'CKGIP', business_status: 'Operational', proposed_business: 'Sari-Sari Store', amount_needed: '₱35,000.00', employment_status: 'Underemployed', seminars: 'Entrepreneurship 101', checklist_status: '4/4 Complete', assignment_status: 'Assigned & Approved', docs: ['PhilID.pdf'] }]
        };

        let programsList = [];
        let selectedProgramId = null;
        let selectedBatchId = null;

        function maskContactNumber(phone) {
            if (!phone) return '09XX-***-XXXX';
            const clean = phone.replace(/[^0-9]/g, '');
            if (clean.length >= 10) return `${clean.substring(0, 4)}-***-${clean.substring(clean.length - 4)}`;
            return '09XX-***-XXXX';
        }

        document.addEventListener('DOMContentLoaded', () => {
            const localData = localStorage.getItem('peso_livelihood_programs_v1');
            if (localData) { try { programsList = JSON.parse(localData); } catch (e) { programsList = [...INITIAL_PROGRAMS]; } }
            else { programsList = [...INITIAL_PROGRAMS]; localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList)); }
            renderDashboardTables();
        });

        function renderDashboardTables() {
            const activeList = programsList.filter(p => p.status === 'Active');
            const archiveList = programsList.filter(p => p.status !== 'Active');
            const totalBudget = programsList.reduce((sum, p) => sum + (Number(p.budget) || 0), 0);

            document.getElementById('statTotalPrograms').textContent = programsList.length;
            document.getElementById('statActivePrograms').textContent = activeList.length;
            document.getElementById('statArchivedPrograms').textContent = archiveList.length;
            document.getElementById('archiveTabBadge').textContent = archiveList.length;
            document.getElementById('archiveSectionCountBadge').textContent = `${archiveList.length} Deactivated Programs`;
            document.getElementById('statTotalBudget').textContent = '₱' + totalBudget.toLocaleString();

            filterPrograms();
            renderAssignProgramsTable();
            renderArchiveTable(archiveList);
        }

        function switchTab(tabName) {
            document.getElementById('tabNavOverview').classList.remove('active');
            document.getElementById('tabNavAssignment').classList.remove('active');
            document.getElementById('tabNavArchive').classList.remove('active');
            document.getElementById('sectionOverview').classList.add('d-none');
            document.getElementById('sectionAssignment').classList.add('d-none');
            document.getElementById('sectionArchive').classList.add('d-none');

            if (tabName === 'overview') { document.getElementById('tabNavOverview').classList.add('active'); document.getElementById('sectionOverview').classList.remove('d-none'); }
            else if (tabName === 'assignment') { document.getElementById('tabNavAssignment').classList.add('active'); document.getElementById('sectionAssignment').classList.remove('d-none'); showLevel1Programs(); }
            else if (tabName === 'archive') { document.getElementById('tabNavArchive').classList.add('active'); document.getElementById('sectionArchive').classList.remove('d-none'); }
        }

        function filterPrograms() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const cat = document.getElementById('categoryFilter').value;
            const status = document.getElementById('statusFilter').value;
            const tbody = document.getElementById('programsTableBody');
            tbody.innerHTML = '';

            const filtered = programsList.filter(p => {
                const matchesSearch = p.name.toLowerCase().includes(search) || p.code.toLowerCase().includes(search);
                const matchesCat = (cat === 'ALL') || (p.category === cat);
                const matchesStatus = (status === 'ALL') || (status === 'Active' && p.status === 'Active') || (status === 'Inactive' && p.status !== 'Active');
                return matchesSearch && matchesCat && matchesStatus;
            });

            filtered.forEach(prog => {
                const tr = document.createElement('tr');
                const isDeactivated = prog.status !== 'Active';
                tr.innerHTML = `
                    <td><div class="fw-bold text-dark">${escapeHtml(prog.name)}</div><span class="badge bg-dark-subtle text-dark font-monospace">${escapeHtml(prog.code)}</span></td>
                    <td><span class="badge badge-category badge-emp">${escapeHtml(prog.category)}</span><div class="small text-muted mt-1">${escapeHtml(prog.assistance_type || '')}</div></td>
                    <td><div class="fw-bold text-success">₱${Number(prog.budget).toLocaleString('en-US', {minimumFractionDigits: 2})}</div></td>
                    <td><span class="badge bg-light text-dark border"><i class="bi bi-people-fill text-primary me-1"></i>${prog.beneficiaries_count || 0} enrolled</span></td>
                    <td><div class="text-truncate" style="max-width: 200px;">${escapeHtml(prog.limitations || 'None')}</div></td>
                    <td><small class="fw-semibold text-secondary">${escapeHtml(prog.ordinance || 'Ordinance No. 6')}</small></td>
                    <td class="text-center">
                        <div class="form-check form-switch d-inline-block">
                            <input class="form-check-input" type="checkbox" role="switch" ${!isDeactivated ? 'checked' : ''} onchange="handleProgramToggle(event, ${prog.id})">
                        </div>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-info me-1" onclick="openProgramDetailsViewModal(${prog.id})">
                            <i class="bi bi-eye-fill"></i> Details
                        </button>
                        <button class="btn btn-sm btn-outline-warning" onclick="openProgramEditModal(${prog.id})">
                            <i class="bi bi-pencil-square"></i> Edit
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Details Modal (Read-Only)
        function openProgramDetailsViewModal(progId) {
            const prog = programsList.find(p => p.id === progId);
            if (!prog) return;
            document.getElementById('viewProgName').textContent = prog.name;
            document.getElementById('viewProgCode').textContent = prog.code;
            document.getElementById('viewProgCategory').textContent = prog.category;
            document.getElementById('viewProgBudget').textContent = '₱' + Number(prog.budget).toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('viewProgBeneficiaries').textContent = `${prog.beneficiaries_count || 0} beneficiaries enrolled`;
            document.getElementById('viewProgDesc').textContent = prog.description || 'N/A';
            document.getElementById('viewProgTarget').textContent = prog.target_beneficiaries || 'N/A';
            document.getElementById('viewProgAssistance').textContent = prog.assistance_type || 'N/A';
            document.getElementById('viewProgEligibility').textContent = prog.eligibility_criteria || 'N/A';
            document.getElementById('viewProgLimitations').textContent = prog.limitations || 'N/A';
            document.getElementById('viewProgOrdinance').textContent = prog.ordinance || 'Appropriation Ordinance No. 6, Series of 2025';
            document.getElementById('viewProgStatus').textContent = prog.status;
            new bootstrap.Modal(document.getElementById('programDetailsViewModal')).show();
            logAuditEvent('VIEW_PROGRAM_DETAILS', `Opened read-only details for ${prog.code}`);
        }

        // Edit Modal (Form Update)
        function openProgramEditModal(progId) {
            const prog = programsList.find(p => p.id === progId);
            if (!prog) return;
            document.getElementById('editProgId').value = prog.id;
            document.getElementById('editProgName').value = prog.name;
            document.getElementById('editProgCode').value = prog.code;
            document.getElementById('editProgBudget').value = prog.budget;
            document.getElementById('editProgAssistance').value = prog.assistance_type || '';
            document.getElementById('editProgDesc').value = prog.description || '';
            document.getElementById('editProgTarget').value = prog.target_beneficiaries || '';
            document.getElementById('editProgEligibility').value = prog.eligibility_criteria || '';
            document.getElementById('editProgLimitations').value = prog.limitations || '';
            new bootstrap.Modal(document.getElementById('programEditModal')).show();
        }

        function handleSaveProgramUpdates(e) {
            e.preventDefault();
            const progId = Number(document.getElementById('editProgId').value);
            const prog = programsList.find(p => p.id === progId);
            if (!prog) return;

            if (confirm(`Confirm Update: Save changes for program "${prog.code}"?`)) {
                prog.name = document.getElementById('editProgName').value.trim();
                prog.budget = Number(document.getElementById('editProgBudget').value) || 0;
                prog.assistance_type = document.getElementById('editProgAssistance').value.trim();
                prog.description = document.getElementById('editProgDesc').value.trim();
                prog.target_beneficiaries = document.getElementById('editProgTarget').value.trim();
                prog.eligibility_criteria = document.getElementById('editProgEligibility').value.trim();
                prog.limitations = document.getElementById('editProgLimitations').value.trim();

                localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList));
                logAuditEvent('EDIT_PROGRAM_DETAILS', `Updated program details for ${prog.code}`);
                bootstrap.Modal.getInstance(document.getElementById('programEditModal')).hide();
                renderDashboardTables();
            }
        }

        function showLevel1Programs() { document.getElementById('assignmentLevel1').classList.remove('d-none'); document.getElementById('assignmentLevel2').classList.add('d-none'); document.getElementById('assignmentLevel3').classList.add('d-none'); renderAssignProgramsTable(); }
        function renderAssignProgramsTable() { const tbody = document.getElementById('assignProgramsTableBody'); tbody.innerHTML = ''; programsList.forEach(prog => { const total = prog.total_slots || 50; const rem = Math.max(0, total - (prog.beneficiaries_count || 0)); const tr = document.createElement('tr'); tr.innerHTML = `<td>${escapeHtml(prog.name)}</td><td>${escapeHtml(prog.category)}</td><td class="text-center">${total}</td><td class="text-center"><span class="badge bg-success-subtle text-success">${rem} slots</span></td><td class="text-center">${prog.status}</td><td class="text-end"><button class="btn btn-primary btn-sm" onclick="showLevel2Batches(${prog.id})">View Batches →</button></td>`; tbody.appendChild(tr); }); }
        function showLevel2Batches(progId) { if (progId) selectedProgramId = progId; const prog = programsList.find(p => p.id === selectedProgramId); document.getElementById('assignmentLevel1').classList.add('d-none'); document.getElementById('assignmentLevel2').classList.remove('d-none'); document.getElementById('batchProgTitle').textContent = `${prog ? prog.name : ''} Batches`; renderBatchesTable(); }
        function renderBatchesTable() { const tbody = document.getElementById('batchesTableBody'); tbody.innerHTML = ''; const batches = PROGRAM_BATCHES[selectedProgramId] || [{ batch_id: 1011, batch_num: 'Batch 2026-A', date: '2026-03-15', trainer: 'Hon. Mark Gonzales', enrolled: 15, total: 15 }]; batches.forEach(b => { const tr = document.createElement('tr'); tr.innerHTML = `<td>${escapeHtml(b.batch_num)}</td><td>${escapeHtml(b.date)}</td><td>${escapeHtml(b.trainer)}</td><td class="text-center">${b.enrolled} / ${b.total}</td><td class="text-center">${b.total - b.enrolled} slots</td><td class="text-end"><button class="btn btn-outline-primary btn-sm" onclick="showLevel3Beneficiaries(${b.batch_id}, '${escapeHtml(b.batch_num)}')">View Beneficiaries →</button></td>`; tbody.appendChild(tr); }); }
        function showLevel3Beneficiaries(batchId, batchNum) { if (batchId) selectedBatchId = batchId; document.getElementById('assignmentLevel2').classList.add('d-none'); document.getElementById('assignmentLevel3').classList.remove('d-none'); document.getElementById('benBatchTitle').textContent = `Beneficiaries Roster — ${batchNum}`; renderBeneficiariesTable(); }
        function renderBeneficiariesTable() { const tbody = document.getElementById('beneficiariesTableBody'); tbody.innerHTML = ''; const list = BATCH_BENEFICIARIES[selectedBatchId] || [{ id: 6, full_name: 'Juan Santos Dela Cruz', phone: '0905-111-2222', checklist_status: '4/4 Complete', assignment_status: 'Assigned & Approved' }]; list.forEach(ben => { const tr = document.createElement('tr'); tr.innerHTML = `<td>${escapeHtml(ben.full_name)}</td><td><span class="masked-phone">${maskContactNumber(ben.phone)}</span></td><td><span class="badge bg-success-subtle text-success">${escapeHtml(ben.checklist_status)}</span></td><td><span class="badge bg-primary">${escapeHtml(ben.assignment_status)}</span></td><td class="text-end"><button class="btn btn-sm btn-info text-white" onclick="openBeneficiaryProfileModal(${ben.id})">View Profile 👁️</button></td>`; tbody.appendChild(tr); }); }
        function openBeneficiaryProfileModal(benId) { const ben = { full_name: 'Juan Santos Dela Cruz', phone: '0905-111-2222', address: 'Barangay Zone IV, Koronadal', age: 29, sex: 'Male', civil_status: 'Single', birthday: '1997-04-12', children: 0, spouse: 'N/A', valid_id: 'PhilID', business_type: 'Sari-Sari Store', program_component: 'CKGIP', business_status: 'Operational', proposed_business: 'Dela Cruz Sari-Sari Store', amount_needed: '₱35,000.00', employment_status: 'Underemployed', seminars: 'Entrepreneurship 101', checklist_status: '4/4 Complete', assignment_status: 'Assigned & Approved', docs: ['PhilID.pdf'] }; document.getElementById('benProfileName').textContent = ben.full_name; document.getElementById('pFullName').textContent = ben.full_name; document.getElementById('pContact').textContent = maskContactNumber(ben.phone); document.getElementById('pAddress').textContent = ben.address; document.getElementById('pAge').textContent = ben.age; document.getElementById('pSex').textContent = ben.sex; document.getElementById('pCivilStatus').textContent = ben.civil_status; document.getElementById('pBirthday').textContent = ben.birthday; document.getElementById('pChildren').textContent = ben.children; document.getElementById('pSpouse').textContent = ben.spouse; document.getElementById('pValidId').textContent = ben.valid_id; document.getElementById('pBusinessType').textContent = ben.business_type; document.getElementById('pProgramComponent').textContent = ben.program_component; document.getElementById('pBusinessStatus').textContent = ben.business_status; document.getElementById('pAmountNeeded').textContent = ben.amount_needed; document.getElementById('pProposedBusiness').textContent = ben.proposed_business; document.getElementById('pEmploymentStatus').textContent = ben.employment_status; document.getElementById('pSeminars').textContent = ben.seminars; document.getElementById('pChecklist').textContent = ben.checklist_status; document.getElementById('pAssignmentStatus').textContent = ben.assignment_status; document.getElementById('pDocsList').innerHTML = ben.docs.map(d => `<span class="badge bg-secondary me-1">${d}</span>`).join(''); new bootstrap.Modal(document.getElementById('beneficiaryProfileModal')).show(); logAuditEvent('VIEW_BENEFICIARY_PROFILE', `Viewed profile for ${ben.full_name}`); }
        function handleProgramToggle(event, progId) { const prog = programsList.find(p => p.id === progId); if (!prog) return; if (!event.target.checked) { if ((prog.beneficiaries_count || 0) > 0) { event.target.checked = true; document.getElementById('restrictionWarningText').innerHTML = `Cannot deactivate program <strong>"${escapeHtml(prog.name)}"</strong>. It currently has active enrolled beneficiaries.`; new bootstrap.Modal(document.getElementById('restrictionWarningModal')).show(); return; } if (confirm(`Deactivate "${prog.name}"?`)) { prog.status = 'Deactivated'; localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList)); logAuditEvent('DEACTIVATE_PROGRAM', `Deactivated ${prog.code}`); renderDashboardTables(); } else { event.target.checked = true; } } else { prog.status = 'Active'; localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList)); logAuditEvent('ACTIVATE_PROGRAM', `Reactivated ${prog.code}`); renderDashboardTables(); } }
        function renderArchiveTable(archiveList) { const tbody = document.getElementById('archiveTableBody'); tbody.innerHTML = archiveList.length === 0 ? `<tr><td colspan="6" class="text-center py-4 text-muted">Archive clean.</td></tr>` : ''; archiveList.forEach(prog => { const tr = document.createElement('tr'); tr.innerHTML = `<td>${escapeHtml(prog.name)}</td><td>${escapeHtml(prog.category)}</td><td>₱${Number(prog.budget).toLocaleString()}</td><td>${escapeHtml(prog.target_beneficiaries || '')}</td><td>${new Date().toLocaleDateString()}</td><td class="text-end"><button class="btn btn-sm btn-success me-1" onclick="restoreProgram(${prog.id})">Restore</button><button class="btn btn-sm btn-outline-danger" onclick="permanentlyDeleteProgram(${prog.id})">Delete</button></td>`; tbody.appendChild(tr); }); }
        function restoreProgram(progId) { const prog = programsList.find(p => p.id === progId); if (prog) { prog.status = 'Active'; localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList)); renderDashboardTables(); } }
        function permanentlyDeleteProgram(progId) { if (confirm('Delete permanently?')) { programsList = programsList.filter(p => p.id !== progId); localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList)); renderDashboardTables(); } }
        function openCreateProgramModal() { new bootstrap.Modal(document.getElementById('createProgramModal')).show(); }
        function handleCreateProgramSubmit(e) { e.preventDefault(); const newProg = { id: Date.now(), name: document.getElementById('newProgName').value.trim(), code: document.getElementById('newProgCode').value.trim().toUpperCase(), category: document.getElementById('newProgCategory').value, budget: Number(document.getElementById('newProgBudget').value) || 0, description: document.getElementById('newProgDesc').value.trim(), target_beneficiaries: document.getElementById('newProgTarget').value.trim(), assistance_type: document.getElementById('newProgAssistance').value, eligibility_criteria: document.getElementById('newProgEligibility').value.trim(), limitations: document.getElementById('newProgLimitations').value.trim(), ordinance: document.getElementById('newProgOrdinance').value.trim(), beneficiaries_count: 0, total_slots: 50, status: 'Active' }; programsList.unshift(newProg); localStorage.setItem('peso_livelihood_programs_v1', JSON.stringify(programsList)); logAuditEvent('CREATE_PROGRAM', `Created new program ${newProg.code}`); bootstrap.Modal.getInstance(document.getElementById('createProgramModal')).hide(); renderDashboardTables(); }
        function openUploadOrdinanceModal() { new bootstrap.Modal(document.getElementById('uploadOrdinanceModal')).show(); }
        function handleUploadOrdinance(e) { e.preventDefault(); logAuditEvent('UPLOAD_ORDINANCE', 'Uploaded Appropriation Ordinance document'); bootstrap.Modal.getInstance(document.getElementById('uploadOrdinanceModal')).hide(); alert('Ordinance uploaded successfully.'); }
        function showOrdinanceReferenceModal() { new bootstrap.Modal(document.getElementById('ordinanceReferenceModal')).show(); }
        function showAuditLogsModal() { new bootstrap.Modal(document.getElementById('auditLogsModal')).show(); }
        function logAuditEvent(actionType, details) { try { const logs = JSON.parse(localStorage.getItem('peso_immutable_audit_logs') || '[]'); logs.unshift({ id: 'AUD-' + Date.now(), timestamp: new Date().toISOString(), userRole: 'PESO Admin', actionType: actionType, targetEntity: 'Program Management & Assignments', details: details }); localStorage.setItem('peso_immutable_audit_logs', JSON.stringify(logs)); } catch (e) {} }
        function toggleDarkMode() { document.body.classList.toggle('dark-mode'); }
        function logoutAdmin() { window.location.href = 'official_login.html'; }
        function escapeHtml(str) { return str ? String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') : ''; }
    </script>
</body>
</html>
